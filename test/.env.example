# Copier en .env avant de déployer (jamais commité, voir .gitignore).
# Port publié en local pour le conteneur placeholder seul (Palier 1/build).
# 8080 est souvent déjà pris sur un poste de développement.
SDOP_TEST_PORT=8081

# Port publié pour le service watermark seul (Palier 1/build, sans passer par
# nginx) — permet de sonder /health sans certificat client.
SDOP_WM_PORT=8082

# Port publié pour nginx (Palier 2 — chaîne stubbée réelle). 8446 plutôt que
# 8443, port par défaut de la démo autonome.
SDOP_CHAIN_PORT=8446

# Port du vhost externe (accès par lien, sans mTLS).
SDOP_EXT_PORT=8447

# Identité renvoyée par le stub Authentik (Palier 2) — valeurs de test, jamais
# une vraie identité.
STUB_USERNAME=test-regression
STUB_GROUPS=tlp-amber-emetteurs
STUB_EMAIL=test-regression@example.internal
STUB_UID=1

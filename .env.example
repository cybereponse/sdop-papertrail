# .env.example — variables de déploiement de SDOP
#
# Copier en `.env` à côté de docker-compose.yml. Ce fichier ne contient AUCUN
# secret : les secrets de SDOP (clé de signature, clé de contenu) sont des
# chemins vers des fichiers déposés par un humain depuis le coffre, jamais des
# valeurs écrites ici.
#
# Rien dans docker-compose.yml ne calcule un nom : le compose ne lit que ces
# variables. (Doctrine reprise de core/.env, côté socle.)

# --- Nom du réseau Docker du socle identité ---
# Réseau `external` fourni par le socle d'identité, différent par
# environnement. Le relever dans la configuration du socle.
# Non renseigné, le défaut du compose vise le réseau de production.
#
# Note : quand le socle dépose son `docker-compose.override.yml` dans le
# répertoire de déploiement, c'est lui qui fixe le nom et cette variable est
# sans effet. Elle sert au cas où on déploie sans cette surcouche.
#SDOP_NETWORK=sdop-identity-net-dev

# --- Réglages du service watermark (défauts dans docker-compose.yml) ---
#SDOP_RENDER_DPI=150
#SDOP_WATERMARK_DENSITY=discret
#SDOP_DOC_TTL_DAYS=45
#SDOP_DOC_MAX_TTL_DAYS=365
#SDOP_LINK_TTL_TOTP=72
#SDOP_LINK_TTL_CODE=96
#SDOP_LINK_SESSION_MINUTES=30
#SDOP_SIEM_PATH=/journal/sdop-events.jsonl

# --- Chemins de secrets montés depuis le coffre ---
# Vides, le service démarre quand même et /health signale la dégradation
# (`signing_key_ephemeral`, stockage en clair) — un chiffrement qu'on croit
# actif sans qu'il le soit serait pire que pas de chiffrement.
#SDOP_SIGNING_KEY=/secrets/sdop-signing.pem
# Sceau PAdES des exports — FACULTATIF. Identité de l'organisation : à fournir,
# aucune valeur par défaut (guillemets : sûrs pour bash comme pour compose).
#SDOP_PADES_SUJET="/C=FR/O=Mon organisme/CN=SDOP — sceau des exports"
#SDOP_PADES_SAN="email:role@exemple.invalid"
# Posés par scripts/gen-secrets.sh une fois le certificat déposé
# (secrets/sdop-pades.crt), jamais avant — une configuration partielle empêche
# le service de démarrer.
#SDOP_PADES_KEY=/secrets/sdop-pades.key
#SDOP_PADES_CERT=/secrets/sdop-pades.crt
# Exiger le sceau (sinon export suspendu) : décision d'exploitation, à la main.
#SDOP_PADES_REQUIRED=1
#SDOP_CONTENT_KEY=
#SDOP_TILE_SECRET=
